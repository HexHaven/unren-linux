# Maintainer: xNyxion <core@nyxion.cloud>
#
# Builds directly from the enclosing project checkout (this PKGBUILD lives at
# packaging/arch/PKGBUILD inside the repo it packages) rather than from a
# tagged upstream tarball, since this project does not yet publish signed
# release archives. `source=()` is intentionally empty; build()/package()
# work directly against the repo root two directories up ($_repo_root).
# Re-run `updpkgsums`/bump pkgrel and pkgver together with the project's own
# version bumps in pyproject.toml.

pkgname=unren-forall-linux
pkgver=0.1.0.r17.gee9004b
pkgrel=1
pkgdesc="Native Linux port of UnRen-forall (Ren'Py game detection/utility toolkit)"
arch=('any')
url="https://github.com/Lurmel/UnRen-forall"
license=('GPL3')
depends=(
  'python'
  'python-rich'
  'python-platformdirs'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-wheel'
  'python-hatchling'
  'git'
)
checkdepends=(
  'python-pytest'
  'python-pytest-cov'
)
optdepends=(
  '7zip: extraction fallback / diagnostics tooling reported by `unren doctor`'
  'git: reported by `unren doctor` diagnostics'
  'python2: legacy unrpyc variant for Ren'"'"'Py <=7 games with a Python-2-bundled runtime (unrpyc_current is used as a fallback otherwise; python2 is AUR-only, not in official Arch repos)'
)
source=()
sha256sums=()

# Repo root: this PKGBUILD lives at <repo>/packaging/arch/PKGBUILD.
_repo_root="$startdir/../.."

# Dev-workflow versioning: derive a deterministic, unique pkgver from git
# state so `makepkg`/`make install` never collides with an already-installed
# build ("already installed" no-ops) and developers never hand-edit pkgver.
#
# - If the repo has release tags: <tag>.r<commits-since-tag>.g<hash>
#   (standard Arch VCS-package idiom; see `git describe --tags --long`).
# - Otherwise (current state - no tags yet): <pyproject-version>.r<total-commits>.g<hash>
#   so every new commit still yields a distinct, deterministic pkgver.
# pkgver() output must only contain alphanumerics, dots and underscores
# (makepkg rejects hyphens/colons), hence the dot-separated format.
#
# Release-workflow note: once this project starts publishing tagged/pinned
# releases to AUR, drop this pkgver() and pin pkgver directly to the
# pyproject.toml version instead.
pkgver() {
  cd "$_repo_root"
  if git describe --tags --long &>/dev/null; then
    git describe --tags --long | sed 's/^v//; s/-/.r/; s/-/./'
  else
    local _base
    _base=$(grep -m1 -Po '(?<=^version = ")[^"]+' pyproject.toml)
    printf '%s.r%s.g%s' "$_base" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
  fi
}

build() {
  cd "$_repo_root"
  rm -rf "$srcdir/dist"
  python -m build --wheel --no-isolation --outdir "$srcdir/dist"
}

check() {
  cd "$_repo_root"
  # The package isn't installed yet at check() time (package() runs after) -
  # point pytest/import machinery at the src/ layout directly rather than
  # requiring an install step first.
  PYTHONPATH="$_repo_root/src" python -m pytest tests/ -q
}

package() {
  cd "$_repo_root"
  python -m installer --destdir="$pkgdir" "$srcdir"/dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
